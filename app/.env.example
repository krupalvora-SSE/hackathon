PORT=3000
# Where the dashboard's "Browser" button reaches the Python bot
BOT_URL=http://localhost:7860

# Exotel (dashboard → API settings). Never commit real values.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
# Your ExoPhone (the number customers see)
EXOTEL_CALLER_ID=
# App ID of the flow containing the Voicebot applet
EXOTEL_FLOW_ID=
# api.exotel.com (Singapore) or api.in.exotel.com (Mumbai), matching your account's cluster
EXOTEL_SUBDOMAIN=api.exotel.com
# Comma-separated team/judge test numbers. Any other number is refused (never call real customers).
EXOTEL_TEST_NUMBERS=

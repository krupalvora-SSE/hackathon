{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Beat Plan call context",
  "description": "What fetch_beatplan_context returns and the bot holds for the whole call. Field names are a proposal until the Beat Plan contract is confirmed.",
  "type": "object",
  "required": ["site_id", "customer", "primary_slot", "backup_slots", "plan_window_end"],
  "properties": {
    "site_id": {"type": "string"},
    "customer": {
      "type": "object",
      "required": ["customer_id", "name", "phone"],
      "properties": {
        "customer_id": {"type": "string"},
        "name": {"type": "string"},
        "salutation": {"type": "string", "enum": ["ji", "sir", "madam"]},
        "phone": {"type": "string"},
        "language_pref": {"type": "string", "enum": ["hi", "en"]},
        "dnc": {"type": "boolean"}
      }
    },
    "address_short": {"type": "string"},
    "service_type": {"type": "string", "description": "Primary service recommendation, e.g. panel cleaning + health check"},
    "primary_slot": {"$ref": "#/definitions/slot"},
    "backup_slots": {"type": "array", "items": {"$ref": "#/definitions/slot"}},
    "plan_window_end": {"type": "string", "format": "date", "description": "Usually today + 15 days"},
    "last_service_date": {"type": ["string", "null"], "format": "date"}
  },
  "definitions": {
    "slot": {
      "type": "object",
      "required": ["date", "band", "hero_id"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "band": {"type": "string", "enum": ["morning", "afternoon", "evening"]},
        "hero_id": {"type": "string"}
      }
    }
  }
}

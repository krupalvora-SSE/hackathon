# Copy to .env (git-ignored). Never commit real keys.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_VOICE=
# LLM: google (Gemini, default) or openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=google
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.6-flash
# only for LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
# Node app (events + booking lookup)
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SILENCE_SECS=6

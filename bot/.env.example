# Copy to .env (git-ignored). Never commit real keys.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_VOICE=
# Cloned voice: pick/record one at http://localhost:7860/voice (saved in bot/voice.json),
# or pin a Sarvam voice id here (overrides the page).
SARVAM_CLONE_VOICE_ID=
# Speaking speed, 0.5-2.0. Cloned voices copy the sample's pace; ~1.2 keeps calls snappy.
SARVAM_TTS_PACE=
# LLM: google (Gemini, default) or openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=google
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.6-flash
# only for LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
# Node app (events + booking lookup)
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SILENCE_SECS=6
# Which call runs: service-scheduling (YAML flow in ../flows, default) or checklist (original 4-key bot)
CALL_FLOW=service-scheduling
# Comma-separated numbers the flow may dial; empty = no allowlist check (hackathon: test numbers only)
ALLOWED_TEST_NUMBERS=
# 1 = refuse calls outside flows/<flow>/policies.yaml calling_hours
ENFORCE_CALLING_HOURS=0

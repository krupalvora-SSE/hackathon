# Copy to .env (git-ignored). Never commit real keys.
# Speech recognition: local Whisper, loaded from the model cache on disk (the bot never downloads models).
STT_PROVIDER=whisper
# Record each whole call (customer left, bot right) to bot/recordings/<call>/call.wav; 0 to turn off
RECORD_CALL=1
# Voice (local Piper): piper, or piper_clone (Piper re-voiced as the sample recorded on /voice, by the
# local converter in bot/clone_tts: cd bot/clone_tts && uv run uvicorn server:app --port 7861 ;
# calls speak plain Piper while it's down)
TTS_PROVIDER=piper
# Voices load only from ~/.cache/pipecat/piper/<voice>.onnx (+ .onnx.json); nothing is downloaded.
# Our trained voices (hi_IN-jasir-medium, hi_IN-krupal-medium) are in bot/models/piper;
# ./setup_models.sh copies them there and fetches the rest.
PIPER_VOICE=hi_IN-jasir-medium
PIPER_VOICE_EN=en_US-ryan-medium
CLONE_TTS_URL=http://127.0.0.1:7861
# Piper + my voice: OpenVoice tau, lower = closer to the sample (0.1-1)
CLONE_TAU=0.3
# Speaking speed, 0.5-2.0; blank is the voice's natural speed, ~1.1-1.2 keeps calls snappy.
TTS_PACE=
# LLM: google (Gemini, default) or openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=google
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.6-flash
# only for LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
# Node app (events + booking lookup)
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SILENCE_SECS=6
# Which call runs: service-scheduling (YAML flow in ../flows, default) or checklist (original 4-key bot)
CALL_FLOW=service-scheduling
# Comma-separated numbers the flow may dial; empty = no allowlist check (hackathon: test numbers only)
ALLOWED_TEST_NUMBERS=
# 1 = refuse calls outside flows/<flow>/policies.yaml calling_hours
ENFORCE_CALLING_HOURS=0
